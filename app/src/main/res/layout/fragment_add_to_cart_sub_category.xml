<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/add_to_cart_sub_tab_layout"
        style="@style/subCategoryTabLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:visibility="gone"
        app:tabTextAppearance="@style/MySubTabTextAppearance" />

    <com.ar.salata.ui.utils.NestedScrollableHost
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/add_to_cart_sub_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.ar.salata.ui.utils.NestedScrollableHost>

</LinearLayout>